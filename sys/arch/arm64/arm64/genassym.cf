include <sys/param.h>
include <sys/proc.h>

include <machine/cpu.h>
include <machine/intr.h>
include <machine/frame.h>
include <machine/pcb.h>
include <machine/vmmvar.h>

define	ARM64_VMM_MODE_NVHE	ARM64_VMM_MODE_NVHE
define	ARM64_VMM_MODE_VHE	ARM64_VMM_MODE_VHE
define	ARM64_VMM_EXIT_SYNC	ARM64_VMM_EXIT_SYNC
define	ARM64_VMM_EXIT_IRQ	ARM64_VMM_EXIT_IRQ
define	ARM64_VMM_EXIT_FIQ	ARM64_VMM_EXIT_FIQ
define	ARM64_VMM_EXIT_SERROR	ARM64_VMM_EXIT_SERROR

struct	sigframe
member	sf_sc

struct	cpu_info
member	ci_curproc
member	ci_curpcb
member	ci_el1_stkend
member	ci_mpidr
member	ci_next
member	ci_trampoline_vectors
member	ci_ttbr1
member	ci_self

struct	proc
member	p_addr
member	p_cpu
member	p_stat
member	P_ASTPENDING	p_md.md_astpending

export	SONPROC

struct	pcb
member	pcb_onfault
member	pcb_flags
member	pcb_sp
member	pcb_tcb

struct	trapframe
member	tf_x
member	tf_sp
member	tf_elr
define	TF_SIZE		sizeof(struct trapframe)

struct	switchframe
member	sf_x19
member	sf_x21
member	sf_x23
member	sf_x25
member	sf_x27
member	sf_x29
define	SWITCHFRAME_SZ sizeof(struct switchframe)

struct	arm64_vmm_run
member	avr_gprs
member	avr_sp
member	avr_sp_el0
member	avr_pc
member	avr_pstate
member	avr_elr_el1
member	avr_spsr_el1
member	avr_esr_el1
member	avr_far_el1
member	avr_sctlr_el1
member	avr_tcr_el1
member	avr_ttbr0_el1
member	avr_ttbr1_el1
member	avr_mair_el1
member	avr_vbar_el1
member	avr_contextidr_el1
member	avr_cpacr_el1
member	avr_cntkctl_el1
member	avr_tpidr_el0
member	avr_tpidrro_el0
member	avr_tpidr_el1
member	avr_fp
member	avr_fpcr
member	avr_fpsr
member	avr_pauth
member	avr_esr_el2
member	avr_far_el2
member	avr_hpfar_el2
member	avr_vttbr_el2
member	avr_vtcr_el2
member	avr_hcr_el2
member	avr_ich_hcr_el2
member	avr_ich_vmcr_el2
member	avr_ich_lr0_el2
member	avr_mode
member	avr_exit
member	avr_async_par
member	avr_async_pc
member	avr_flush_tlb
member	avr_tlbi_arg
member	avr_cntv_ctl_el0
member	avr_cntv_cval_el0
member	avr_cntvct_el0
member	avr_cntvoff_el2
member	avr_cnthctl_el2
member	avr_vmpidr_el2
member	avr_defer_cnthv
member	avr_host_sp
member	avr_host_sp_el0
member	avr_host_pc
member	avr_host_pstate
member	avr_host_elr_el1
member	avr_host_spsr_el1
member	avr_host_esr_el1
member	avr_host_far_el1
member	avr_host_sctlr_el1
member	avr_host_tcr_el1
member	avr_host_ttbr0_el1
member	avr_host_ttbr1_el1
